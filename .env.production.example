# LORDICL — production .env template for lordicl.com (copy to .env on the server and fill the blanks).
# Secrets are NEVER in the repository. Lines marked (copy from PC) must carry the same value as the
# dev PC's .env, everything else is set for the server.

APP_NAME="Lord Jeweller"
APP_ENV=production
APP_KEY=                      # copy from PC — same key, or stored encrypted values stop decrypting
APP_DEBUG=false
APP_URL=https://lordicl.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Databases: the new software + the legacy copy (reports read it; the importer reads it on rebuild)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lordicl_live
DB_USERNAME=
DB_PASSWORD=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=lordicl
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database        # drained by cron:run / schedule:run — no worker needed
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lordicl.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"

# ---- integrations (copy from PC unless noted)
RAZORPAY_KEY=                 # rzp_live_… on production
RAZORPAY_SECRET=
WHATSAPP_TEST_RECIPIENT=      # MUST stay blank on live — else every OTP / QR goes to the test phone
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
PAN_DRIVER=
PAN_ENDPOINT=
PAN_KEY=
PAN_SECRET=
PAN_VERSION=
DATA_GOV_IN_KEY=
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
MONTHLY_TASKS_ENABLED=false

# ---- go-live 2026-11-01
PAYOUT_CUTOFF_PASSWORD=       # the board's admin pass-phrase: Generate cut-off + back-dated billing
LEGACY_SITE_URL=https://old.lordicl.com   # lordicl.com/app/* (old Android app) is forwarded here

# ---- L-BOX voice (only if the box services run on this server; see docs/ROLLOUT.md)
LBOX_STT_PYTHON=
LBOX_STT_PYTHONPATH=
LBOX_FFMPEG_BIN=
LBOX_EDGE_CMD=

# Exotel missed-call verification (Account SID, API key/token from the Exotel dashboard; Exophone to miss-call; webhook key = any long random string)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=
EXOTEL_WEBHOOK_KEY=
